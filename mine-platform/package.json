{
  "name": "mine-tunnel-webgpu-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "esbuild test/smoke.ts --bundle --platform=node --format=esm --outfile=test/smoke.mjs && node test/smoke.mjs",
    "test:e2e": "esbuild test/e2e.ts --bundle --platform=node --format=esm --outfile=test/e2e.mjs --external:playwright && node test/e2e.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@webgpu/types": "^0.1.51",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "playwright": "^1.65.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
