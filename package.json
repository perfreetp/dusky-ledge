{
  "name": "workshop-floor-marking-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "车间地面安全标线与区域划分矢量编辑器 (Vue 3 + WebGPU)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "seed": "tsx server/seed.ts"
  },
  "dependencies": {
    "clipper-lib": "6.4.2",
    "earcut": "3.2.4",
    "express": "5.3.0",
    "vue": "3.5.45",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.11",
    "@webgpu/types": "^0.1.64",
    "concurrently": "10.0.7",
    "playwright-core": "1.65.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
